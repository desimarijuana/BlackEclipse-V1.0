// ── Seed the Graph Studio integration demo ───────────────────────────────────
// Creates (idempotently) the two demo workflows used to show the new nodes in
// Overview, and prepares the inbound webhook demo:
//   * a WorkflowWebhook linked to the `hook` node, armed with network access;
//   * `.black-eclipse/demo/webhook-demo.ps1`, a ready-to-run signed request.
//
// The generated secret is written ONLY to the gitignored helper file and the
// encrypted webhook row. It is never printed or committed.
//
// Run: npx tsx scripts/seed-integration-demo.mts

import fs from 'node:fs';
import path from 'node:path';
import { buildTemplate } from '../src/lib/graph-studio/templates';
import { createWorkflow, getWorkflow, listWorkflows } from '../src/lib/graph-studio/server-store';
import {
  armWebhook,
  createWebhook,
  listWebhooks,
  rotateWebhookSecret,
  updateWebhook,
} from '../src/lib/graph-studio/webhook-store';
import { prisma } from '../src/lib/db';

const DEMO_WORKFLOW = 'Webhook to HTTP (demo)';
const SIGNED_WORKFLOW = 'Signed webhook (demo)';
const HELPER = path.join(process.cwd(), '.black-eclipse', 'demo', 'webhook-demo.ps1');

async function ensureWorkflow(name: string, templateId: string): Promise<string> {
  const ir = buildTemplate(templateId);
  if (!ir) throw new Error(`unknown template ${templateId}`);
  const existing = (await listWorkflows({ includeArchived: true })).find((item) => item.name === name);
  if (existing) {
    // Keep the gallery copy current without creating a new workflow version.
    await prisma.workflow.update({
      where: { id: existing.id },
      data: { description: ir.description },
    }).catch(() => {});
    console.log(`reuse  ${name} (${existing.id}, v${existing.currentVersion})`);
    return existing.id;
  }
  const created = await createWorkflow({
    name,
    description: ir.description,
    ir,
    tags: ['demo', 'integration'],
  });
  console.log(`create ${name} (${created.id}, v${created.version})`);
  return created.id;
}

function psQuote(value: string): string {
  return value.replace(/'/g, "''");
}

async function prepareWebhook(workflowId: string): Promise<void> {
  const workflow = await getWorkflow(workflowId);
  if (!workflow) throw new Error('webhook demo workflow not found');
  const hook = workflow.ir.nodes.find((node) => node.type === 'trigger.webhook');
  if (!hook) throw new Error('webhook demo workflow has no trigger.webhook node');

  const existing = (await listWebhooks(workflowId)).find((item) => item.nodeId === hook.id);
  let webhook = existing;
  let secret: string;
  if (webhook) {
    const rotated = await rotateWebhookSecret(webhook.id);
    if (!rotated) throw new Error('could not rotate the demo webhook secret');
    webhook = rotated.webhook;
    secret = rotated.secret;
    console.log(`rotate ${webhook.endpoint}`);
  } else {
    const created = await createWebhook({ workflowId, nodeId: hook.id, name: 'Demo webhook' });
    webhook = created.webhook;
    secret = created.secret;
    console.log(`create ${webhook.endpoint}`);
  }

  webhook = await updateWebhook(webhook.id, {
    name: 'Demo webhook',
    enabled: true,
    allowedMethods: ['POST', 'GET'],
    responseMode: 'immediate',
    verificationMode: 'hmac',
  }) ?? webhook;
  const armed = await armWebhook(webhook.id, { allowNetwork: true });
  console.log(`arm    ${armed.mode} v${armed.version} (network granted)`);

  const body = JSON.stringify({
    event: 'eclipse-demo',
    symbol: 'AAPL',
    note: 'Hello from a signed Eclipse webhook',
  });
  const helper = `# Generated by scripts/seed-integration-demo.mts — do not commit.
param(
  [string]$BaseUrl = 'http://127.0.0.1:3000'
)
$ErrorActionPreference = 'Stop'
$body = @'
${body}
'@
$bodyBytes = [Text.Encoding]::UTF8.GetBytes($body)
$timestamp = [DateTimeOffset]::UtcNow.ToUnixTimeSeconds().ToString()
$secret = '${psQuote(secret)}'
$hmac = [System.Security.Cryptography.HMACSHA256]::new([Text.Encoding]::UTF8.GetBytes($secret))
$signed = [Text.Encoding]::UTF8.GetBytes("$timestamp." + $body)
$signature = 'sha256=' + (([BitConverter]::ToString($hmac.ComputeHash($signed)) -replace '-', '').ToLower())
$headers = @{
  'X-Eclipse-Timestamp' = $timestamp
  'X-Eclipse-Signature' = $signature
  'X-Eclipse-Delivery'  = [guid]::NewGuid().ToString()
  'Content-Type'        = 'application/json'
}
$url = $BaseUrl.TrimEnd('/') + '${webhook.endpoint}'
Write-Host "POST $url"
$response = Invoke-RestMethod -Method Post -Uri $url -Headers $headers -Body $bodyBytes
$response | ConvertTo-Json -Depth 8
`;
  fs.mkdirSync(path.dirname(HELPER), { recursive: true });
  fs.writeFileSync(HELPER, helper, 'utf8');
  console.log(`helper ${HELPER}`);
  console.log(`endpoint ${webhook.endpoint} (secret is in the helper file only)`);
}

try {
  const webhookId = await ensureWorkflow(DEMO_WORKFLOW, 'webhook-http');
  await ensureWorkflow(SIGNED_WORKFLOW, 'signed-webhook');
  await prepareWebhook(webhookId);
  console.log('\nOpen Overview, then the "Webhook to HTTP (demo)" workflow.');
  console.log('Run: powershell -File .black-eclipse/demo/webhook-demo.ps1');
} finally {
  await prisma.$disconnect();
}
