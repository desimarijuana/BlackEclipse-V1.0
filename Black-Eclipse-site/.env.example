# ── BlackEclipse — production environment template ───────────────────────────
# Copy to `.env` and fill in. `.env`/`.env.*` are gitignored; never commit real
# secrets. See docs/QUICKSTART.md and docs/harness/authentication.md.
#
# One container runs BOTH services: `next start` boots the web app, and the app
# spawns the Python FastAPI harness (uvicorn) as a child on first harness request
# (default http://127.0.0.1:8765). Nothing extra is needed for that.

# ── Core ─────────────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=3000

# ── Development / production servers ────────────────────────────────────────
# `npm run dev` and `npm run up` are separate servers on separate ports, so both
# can run at once. The launcher sets these in the child process; they override
# anything in this file. See docs/environments.md.
#   development: app 3000, harness 8765, state in .black-eclipse/dev/
#   production:  app 3100, harness 8766, state in the repo root
# BE_DEV_PORT=3000
# BE_DEV_HARNESS_PORT=8765
# BE_PROD_PORT=3100
# BE_PROD_HARNESS_PORT=8766

# ── Single canonical origin (optional) ───────────────────────────────────────
# When set, any request on a different host redirects here (307, path + query
# preserved) so there is ONE app URL with one set of origin-scoped storage. The
# production launcher (`npm run up` / `black eclipse`) sets this automatically;
# `npm run dev` deliberately leaves it unset so the dev server is never
# redirected to production. Leave unset for `npm run dev:next` too.
# BE_CANONICAL_HOST=blackeclipse

# ── Authentication (REQUIRED when publicly reachable) ────────────────────────
# `production` auto-enables auth; without a valid secret every request fails
# closed with 503. Generate the secrets with:  openssl rand -hex 32
HARNESS_AUTH=required
HARNESS_AUTH_SECRET=change-me-to-a-random-secret
# Operator token guarding /api/cron/* and the Python runtime's non-loopback bind.
CRON_SECRET=change-me-to-a-random-secret

# ── Connector credential encryption ──────────────────────────────────────────
# Base64-encoded 32-byte AES key. Generate with:  openssl rand -base64 32
CONNECTOR_SECRET_KEY=

# ── Model provider (choose one; otherwise the runtime has no LLM) ─────────────
# OPENAI_API_KEY=
# OPENAI_BASE_URL=
# ANTHROPIC_API_KEY=
# Local, keyless: point at an Ollama/LM Studio on the host from inside Docker.
# OLLAMA_BASE_URL=http://host.docker.internal:11434

# ── Data / search providers (optional) ───────────────────────────────────────
# FRED_API_KEY=
# BEA_API_KEY=
# BLS_API_KEY=
# TAVILY_API_KEY=
# BRAVE_API_KEY=
# EXA_API_KEY=
# SERPER_API_KEY=
# FIRECRAWL_API_KEY=

# ── Python harness location (co-located by default) ──────────────────────────
# HARNESS_PY_URL=http://127.0.0.1:8765
# HARNESS_CALLBACK_URL=http://127.0.0.1:3000

# RSL — Recursive Self-Improvement Loop. Dark by default; enable through the
# documented rollout (observe -> propose -> verify -> auto). `auto` proposes and
# verifies but never lands a change. A mode change requires a runtime restart.
# See docs/self-improvement/rsl-implementation-plan.md §5.1.
# HARNESS_RSL_MODE=off
# HARNESS_RSL_STRATEGY=rsl
# HARNESS_RSL_MAX_CANDIDATES=5
# HARNESS_RSL_MAX_EXPERIMENTS_PER_DAY=3
# HARNESS_RSL_TRIALS=3
# HARNESS_RSL_K=1
# HARNESS_RSL_GENERATIONS=1
# HARNESS_RSL_TICK_SECONDS=300
# HARNESS_RSL_LEASE_SECONDS=1800
# HARNESS_RSL_MAX_WALL_SECONDS=1800
# HARNESS_RSL_MAX_COST_USD=5
# Retire measured non-positive lessons (inert: never deletes or enables anything).
# HARNESS_RSL_LESSON_RETIRE=off

# Archive sampling: keep measured states that did not beat the champion as inert
# stepping stones and sample an exploration parent from them. Off by default.
# A stepping stone is never promotable, activatable or current.
# HARNESS_RSL_ARCHIVE=off
# HARNESS_RSL_ARCHIVE_MAX=200
# HARNESS_RSL_ARCHIVE_SAMPLE=weighted   # uniform | weighted | uct

# Metaproductivity: rank exploration parents by what their measured descendants
# achieved (descendant lift), not only by the parent's own score. Sampling only;
# it never decides acceptance. Off by default.
# HARNESS_RSL_CMP=off
# HARNESS_RSL_CMP_HORIZON=3

# Novelty veto: reject a proposal whose typed operator/op set is closer than
# this Jaccard distance to one already tried. 0 = off.
# HARNESS_RSL_NOVELTY_MIN=0

# Islands: each non-global scope climbs independently; every N measured states
# its best state migrates into the global archive as an inert stepping stone.
# HARNESS_RSL_ISLANDS=off
# HARNESS_RSL_ISLAND_MIGRATION=5

# Paired significance: a measured lift must clear its paired-bootstrap noise
# floor (and enough tasks must be paired) before it can be accepted. Off by
# default; enabling it makes a small, noisy win a rejection.
# HARNESS_RSL_SIGNIFICANCE=off
# HARNESS_RSL_SIGNIFICANCE_MIN_TASKS=5

# Supervised autonomy. `supervised`/`bounded` may apply only L1 (bounded surface)
# changes that clear every admission rule; L0 (code, tool widening, guardrail
# removal, model identity) is never automatic. The kill switch is persisted and
# stops every automatic decision without a restart.
# HARNESS_RSL_AUTONOMY=off
# HARNESS_RSL_AUTO_MIN_LIFT=0.02
# HARNESS_RSL_AUTO_MAX_PER_DAY=1
# HARNESS_RSL_AUTO_RISK=low

# Measured code candidates: run the deterministic benchmark in a patched worktree.
# Off by default because it executes the patched harness in a child process.
# HARNESS_RSL_CODE_BENCHMARK=off

# Model-assisted proposals (off by default; deterministic validation still decides).
# HARNESS_RSL_MODEL_PROPOSER=off
# HARNESS_RSL_PROVIDER=ollama
# HARNESS_RSL_MODEL=llama3.1
# HARNESS_RSL_BASE_URL=
# HARNESS_RSL_API_KEY=
