{
  "name": "black-eclipse",
  "version": "0.3.0",
  "private": true,
  "bin": {
    "black": "bin/black.js",
    "eclipse": "scripts/eclipse.js"
  },
  "scripts": {
    "postinstall": "prisma generate && node scripts/setup-python.js && node scripts/link-global.js && node scripts/install-git-hooks.js",
    "setup:python": "node scripts/setup-python.js",
    "setup:pine": "npm --prefix pine-engine install --omit=dev --no-audit --no-fund",
    "setup:git": "node scripts/install-git-hooks.js",
    "setup:desktop": "node scripts/desktop-shortcut.js",
    "setup:hostname": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/setup-hostname.ps1",
    "setup:tls": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/setup-tls.ps1",
    "auth:setup": "node scripts/enable-auth.js",
    "tls:remove": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/setup-tls.ps1 -Uninstall",
    "predev": "node scripts/doctor.js && node scripts/kill-port.js dev",
    "dev": "node scripts/local-host.js dev",
    "dev:next": "next dev --turbopack",
    "dev:local": "next dev --turbopack -H 127.0.0.1",
    "proxy": "node scripts/local-proxy.js",
    "proxy:stop": "node scripts/local-proxy-stop.js",
    "prestart": "node scripts/doctor.js && node scripts/kill-port.js prod",
    "up": "node scripts/doctor.js && node scripts/up.js",
    "build": "node scripts/build-prod.js",
    "postbuild": "node scripts/mark-build.js",
    "start": "node scripts/local-host.js start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run && node scripts/test-python.js && node scripts/test-evals.js",
    "test:py": "node scripts/test-python.js",
    "rotate:changelog": "node scripts/rotate-changelog.js",
    "eval:registry": "node scripts/generate-tool-registry.js",
    "eval:benchmarks": "node scripts/generate-benchmarks.js",
    "eval:live": "node scripts/run-live-evals.js",
    "check:adr": "node scripts/check-adr-numbers.js",
    "check:size": "node scripts/size-budget.js",
    "check:secrets": "node scripts/scan-secrets.js",
    "self:maintenance": "node scripts/self-maintenance.js",
    "vault:plan": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/setup-data-vault.ps1 -DryRun",
    "vault:setup": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/setup-data-vault.ps1 -Apply",
    "data:wipe": "node scripts/wipe-personal-data.js",
    "test:rsl": "node scripts/test-python.js python/tests/test_rsl_loop.py python/tests/test_rsl_config.py python/tests/test_rsl_recursion.py python/tests/test_rsl_hillclimb.py python/tests/test_rsl_archive.py python/tests/test_rsl_cmp.py python/tests/test_rsl_operators.py python/tests/test_rsl_islands.py python/tests/test_significance.py python/tests/test_rsl_significance.py python/tests/test_autonomy.py python/tests/test_autonomy_apply.py python/tests/test_rsl_guardrails.py python/tests/test_rsl_session.py python/tests/test_rsl_digest.py python/tests/test_rsl_snapshot.py python/tests/test_rsl_landing.py python/tests/test_rsl_verifier.py python/tests/test_surface_lab.py python/tests/test_surface_candidate.py python/tests/test_surface_context_policy.py python/tests/test_evolution_rsl_routes.py python/tests/test_evolution_corpus_routes.py python/tests/test_evolution_rsl_operator.py python/tests/test_post_landing.py python/tests/test_drift_watch.py python/tests/test_evaluation_nightly.py python/tests/test_evaluation_export.py python/tests/test_replay_builder.py",
    "test:evals": "node scripts/test-evals.js",
    "test:drift-ui": "node scripts/drift-ui-smoke.mjs",
    "test:drift-app": "node scripts/drift-app-smoke.mjs",
    "test:drift": "node scripts/drift-ui-smoke.mjs && node scripts/drift-app-smoke.mjs",
    "rsl:smoke": "node scripts/rsl-smoke.js",
    "rsl:bench": "node scripts/rsl-bench.js",
    "rsl:corpus": "node scripts/rsl-corpus.js",
    "rsl:manifest": "node scripts/rsl-manifest.js",
    "rsl:rotate": "node scripts/rsl-rotate.js",
    "rsl:nightly": "node scripts/rsl-nightly.js",
    "rsl:lab": "node scripts/rsl-lab.js",
    "test:anatomy": "node scripts/anatomy-smoke.cjs",
    "test:smoke": "node scripts/test-python.js smoke",
    "test:presets": "node scripts/test-presets.js",
    "graph:manifest": "tsx scripts/graph-manifest.mts",
    "graph:loop": "tsx scripts/graph-loop-demo.mts",
    "demo:graph-media": "tsx scripts/seed-graph-media-demo.mts",
    "demo:btc": "tsx scripts/demo-btc.mts",
    "demo:transform": "node scripts/demo-transform.js",
    "demo:loop": "node scripts/demo-loop.js",
    "eclipse": "node scripts/eclipse.js",
    "security:preflight": "node scripts/security-preflight.js",
    "check:all": "node scripts/check-all.js"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@base-ui/react": "^1.5.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@monaco-editor/react": "^4.7.0",
    "@phosphor-icons/react": "^2.1.10",
    "@prisma/adapter-better-sqlite3": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "@tiptap/extension-code-block-lowlight": "^3.32.0",
    "@tiptap/extension-image": "^3.32.0",
    "@tiptap/extension-link": "^3.32.0",
    "@tiptap/extension-placeholder": "^3.32.0",
    "@tiptap/extension-table": "^3.32.0",
    "@tiptap/extension-table-cell": "^3.32.0",
    "@tiptap/extension-table-header": "^3.32.0",
    "@tiptap/extension-table-row": "^3.32.0",
    "@tiptap/markdown": "^3.32.0",
    "@tiptap/react": "^3.32.0",
    "@tiptap/starter-kit": "^3.32.0",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/addon-web-links": "^0.11.0",
    "@xterm/xterm": "^5.5.0",
    "@xyflow/react": "^12.12.0",
    "axios": "^1.19.0",
    "better-sqlite3": "^13.0.3",
    "cheerio": "^1.2.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "duck-duck-scrape": "^2.2.7",
    "echarts": "^6.1.0",
    "echarts-gl": "^2.1.0",
    "flexsearch": "^0.7.31",
    "immer": "^11.1.18",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "katex": "^0.16.47",
    "lowlight": "^3.3.0",
    "mermaid": "^12.1.0",
    "monaco-editor": "^0.57.0",
    "next": "15.5.18",
    "node-cron": "^4.6.0",
    "nodemailer": "^9.1.1",
    "ogl": "^1.0.11",
    "pdfjs-dist": "^4.10.38",
    "playwright": "^1.62.1",
    "prisma": "^7.9.1",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "recharts": "^3.8.1",
    "rss-parser": "^3.13.0",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "agentation": "^3.0.2",
    "eslint": "^9",
    "eslint-config-next": "15.5.18",
    "shadcn": "^4.8.3",
    "tailwindcss": "^4",
    "tsx": "^4.22.4",
    "typescript": "^5",
    "vitest": "^4.1.10"
  }
}
