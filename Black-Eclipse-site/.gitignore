# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/.next-dev/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
*.log
dev-server.log
dev-log.txt

# database backups
*.sql
jdds_backup.sql

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/src/generated/prisma

# Database (JDdS). The 60 MB runtime vault is NOT tracked: committing a binary
# that shows modified on every run bloats the repo and is not a code artifact.
# A fresh clone gets a working vault without any manual step: `scripts/doctor.js`
# (run by `predev`/`prestart`/`up`) creates it with `npx prisma db push` when it
# is absent and applies additive schema drift to an existing one. Local WAL/side
# files are ignored too.
jdds.db
jdds.db-*

# Harness agent-memory database (separate from JDdS; runtime operational state)
agent-memory.db
agent-memory.db-*

# Eclipse-Memory database (dedicated memory/skills/learning; runtime state)
eclipse-memory.db
eclipse-memory.db-*

# MCP server configuration (Phase 5). May hold scoped env VALUES (secrets) for
# local MCP servers, so it is runtime state and is NEVER committed — same tier
# as agent-memory.db. The shipped default is an example, not a secret store.
mcp-servers.json
mcp-servers.json.tmp

# Per-conversation session workspaces (user uploads + agent output). Runtime
# data, never committed — same tier as agent-memory.db.
/.black-eclipse/

# Python runtime state. `python/.black-eclipse/channels/secret.key` is generated
# key material for the channel gateway — NEVER commit it.
/python/.black-eclipse/

# Python agent-runtime artifacts
__pycache__/
*.py[cod]
.pytest_cache/
python/**/*.egg-info/
# Agent session trajectories written under python/ (runtime-only, never source)
python/csess_*/

# rolling DB backups created by scripts/db-guard.js
/backups/

# Test scratch directories (temp fixtures / MCP workflows). Runtime-only, never
# committed; on Windows these may be unreadable by git while a test still holds
# them, so they must be ignored rather than tracked.
/.test-tmp/
.tmp-tests/
/scripts/scratch/

# vendored embedded Python (downloaded on-demand, never committed)
/scripts/vendor/python/

# Rust video worker (fframes): build output and render artifacts are runtime
# data, never committed. The crate source and its Cargo.lock ARE tracked.
/rust/**/target/
/rust/**/out/
/rust/**/frames/
/rust/**/strip.png
/rust/**/onion.png

# Universal Data Connector Layer — locally auto-generated encryption key for
# connector credentials. NEVER commit this: it decrypts stored API secrets.
.connector-key

# Downloaded installers / archives that land in asset folders by accident (e.g. a
# browser download dropped into public/backgrounds/). These are not source and are
# often hundreds of MB; committing one bloats the repo irreversibly.
*.exe
*.msi
*.dmg
*.pkg
*.apk
*.iso
*.app
local-*-windows.*
local-*-mac.*
local-*-linux.*

# Ad-hoc screenshot/scratch output from manual computer-use stress runs. Runtime
# artifacts belong under .black-eclipse/; these stray dirs are never source.
python/sec/
sec/
# The bundled SEC reference plugin is SOURCE, not one of those scratch dirs.
# The bare `sec/` pattern above matches a directory of that name at ANY depth,
# so it was silently excluding python/harness/plugins/bundled/sec/ from version
# control: a clean clone shipped without a reference plugin, and the plugin
# marketplace gate failed on every checkout that was not the author's own
# working tree. Re-include it explicitly.
!python/harness/plugins/bundled/sec/

