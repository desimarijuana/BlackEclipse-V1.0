generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum MarketType {
  STOCKS
  COMMODITIES
  FOREX
}

enum ReportStatus {
  DRAFT
  GENERATING
  COMPLETED
  FAILED
}

model User {
  id          String    @id @default(cuid())
  name        String?
  email       String    @unique
  emailVerified Boolean @default(false)
  image       String?
  passwordHash String?
  role        String    @default("user")
  banned      Boolean   @default(false)
  banReason   String?
  banExpires  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  accounts   Account[]
  sessions   Session[]
  reports    Report[]
  watchlists Watchlist[]

  @@map("users")
}

model Account {
  id              String  @id @default(cuid())
  userId          String
  accountId       String
  providerId      String
  accessToken     String?
  refreshToken    String?
  accessTokenExpiresAt DateTime?
  refreshTokenExpiresAt DateTime?
  scope           String?
  idToken         String?
  password        String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  userId       String
  token        String   @unique
  expiresAt    DateTime
  ipAddress    String?
  userAgent    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("verifications")
}

model Report {
  id          String       @id @default(cuid())
  userId      String
  title       String
  asset       String
  marketType  MarketType
  content     Json?
  status      ReportStatus @default(DRAFT)
  summary     String?
  pdfUrl      String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("reports")
}

model Watchlist {
  id        String   @id @default(cuid())
  userId    String
  name      String
  assets    Json     @default("[]")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("watchlists")
}

// ─── Financial Data Models (Separated Crypto & Equities Universe) ─────

model CryptoAsset {
  id        String   @id @default(cuid())
  symbol    String   @unique // e.g. "BTC", "ETH"
  firstSeen DateTime @default(now()) @map("first_seen")
  lastSeen  DateTime @default(now()) @map("last_seen")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  markets   CryptoMarket[]
  price     CryptoPrice?

  @@map("crypto_assets")
}

model CryptoMarket {
  id         String      @id @default(cuid())
  assetId    String      @map("asset_id")
  symbol     String      @unique // e.g. "BTCUSDT"
  baseAsset  String      @map("base_asset")
  quoteAsset String      @map("quote_asset")
  exchange   String      @default("binance")
  status     String
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  asset      CryptoAsset @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@map("crypto_markets")
}

model CryptoPrice {
  assetId     String      @id @map("asset_id")
  price       Float
  volume      Float
  change24h   Float       @map("change_24h")
  lastUpdated DateTime    @default(now()) @updatedAt @map("last_updated")

  asset       CryptoAsset @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@map("crypto_prices")
}

model StockAsset {
  id        String      @id @default(cuid())
  symbol    String      @unique // e.g. "AAPL", "TSLA"
  name      String
  country   String      @default("US")
  firstSeen DateTime    @default(now()) @map("first_seen")
  lastSeen  DateTime    @default(now()) @map("last_seen")
  isActive  Boolean     @default(true) @map("is_active")
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  price     StockPrice?

  @@map("stock_assets")
}

model StockPrice {
  assetId       String     @id @map("asset_id")
  price         Float
  changePercent Float      @map("change_percent")
  marketCap     Float?     @map("market_cap")
  lastUpdated   DateTime   @default(now()) @updatedAt @map("last_updated")

  asset         StockAsset @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@map("stock_prices")
}

model SystemConfig {
  key   String @id
  value String

  @@map("system_configs")
}

// ─── Portfolio Intelligence System Models ───────────────────────────────

model PortfolioProfile {
  id           String        @id @default(cuid())
  userId       String        @map("user_id")
  name         String        @default("Default Portfolio")
  currency     String        @default("USD")
  taxMethod    String        @default("FIFO") @map("tax_method")
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")
  
  transactions PortfolioTransaction[]
  snapshots    PortfolioSnapshot[]
  alerts       PortfolioAlert[]

  @@map("portfolio_profiles")
}

model PortfolioTransaction {
  id           String        @id @default(cuid())
  profileId    String        @map("profile_id")
  type         String        // BUY, SELL, DEPOSIT, WITHDRAWAL, SWAP
  symbol       String        // BTC, ETH, USDC
  quantity     Float
  price        Float
  fee          Float         @default(0)
  date         DateTime
  notes        String?
  
  profile      PortfolioProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@map("portfolio_transactions")
}

model PortfolioSnapshot {
  id           String        @id @default(cuid())
  profileId    String        @map("profile_id")
  netAssetVal  Float         @map("net_asset_val")
  costBasis    Float         @map("cost_basis")
  realizedPnL  Float         @map("realized_pnl")
  timestamp    DateTime      @default(now())
  
  profile      PortfolioProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  
  @@index([profileId, timestamp])
  @@map("portfolio_snapshots")
}

model PortfolioAlert {
  id           String        @id @default(cuid())
  profileId    String        @map("profile_id")
  symbol       String
  type         String        // PRICE_ABOVE, PRICE_BELOW, ALLOC_EXCEEDS
  target       Float
  isActive     Boolean       @default(true) @map("is_active")
  
  profile      PortfolioProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@map("portfolio_alerts")
}

model NewsArticle {
  id            String   @id @default(cuid())
  source        String
  ticker        String?
  headline      String   @unique
  summary       String
  sentiment     String   // "bullish" | "bearish" | "neutral"
  impactPercent Float
  url           String?
  publishedAt   DateTime
  createdAt     DateTime @default(now())

  @@map("news_articles")
}

model AssetSymbol {
  id                 String   @id @default(cuid())
  symbol             String
  displayName        String?
  assetClass         String
  market             String
  country            String?
  exchange           String?
  currency           String?
  timezone           String?
  dataSource         String?
  isActive           Boolean  @default(true)
  isBacktestEnabled  Boolean  @default(false)
  availableTimeframes String[]
  dataStatus         String   @default("needs_download")
  lastSyncedAt       DateTime?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  candles            HistoricalCandle[]

  @@unique([symbol, exchange, assetClass])
  @@index([assetClass])
  @@index([market])
  @@index([country])
  @@index([exchange])
  @@map("asset_symbols")
}

model HistoricalCandle {
  id          String   @id @default(cuid())
  symbolId    String   @map("symbol_id")
  symbol      AssetSymbol @relation(fields: [symbolId], references: [id], onDelete: Cascade)
  timeframe   String
  timestamp   DateTime
  open        Float
  high        Float
  low         Float
  close       Float
  volume      Float?
  source      String?
  quality     String?
  createdAt   DateTime @default(now())

  @@unique([symbolId, timeframe, timestamp])
  @@index([symbolId])
  @@index([timeframe])
  @@index([timestamp])
  @@map("historical_candles")
}

model JDDSJob {
  id          String   @id @default(cuid())
  type        String
  status      String
  priority    Int      @default(5)
  symbolId    String?  @map("symbol_id")
  timeframe   String?
  startDate   DateTime? @map("start_date")
  endDate     DateTime? @map("end_date")
  provider    String?
  progress    Int      @default(0)
  error       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("jdds_jobs")
}


