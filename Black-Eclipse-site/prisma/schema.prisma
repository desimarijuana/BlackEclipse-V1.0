// JDDS — Joint Data Distribution System
// SQLite-backed data vault. Stores scraped market data once and distributes
// it to every screen. Zero-config (local file DB).

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

// A market / exchange (e.g. US, Pakistan, India, China, Crypto).
model Market {
  id         String  @id
  country    String  @unique // 'US', 'PK', 'IN', 'CN', 'CRYPTO', ...
  exchange   String
  timezone   String
  openHour   Int
  closeHour  Int
  enabled    Boolean @default(true)
  isCrypto   Boolean @default(false)
  createdAt  DateTime @default(now())
  assets     Asset[]
}

// A single tradable asset belonging to a market.
// Dedup: the @@unique([marketId, symbol]) constraint guarantees at most one
// asset per (market, symbol) — re-importing the same symbol updates in place
// instead of creating a duplicate.
model Asset {
  id           String  @id @default(cuid())
  symbol       String
  name         String
  marketId     String
  sector       String?
  industry     String?
  country      String?
  // Security type / asset class from the market universe (e.g. 'Common Stock',
  // 'ETF', 'Mutual Fund', 'ADR', 'Preferred Stock', 'Warrant', ...).
  securityType String?
  assetClass   String?
  isActive     Boolean @default(true)
  createdAt    DateTime @default(now())

  market Market @relation(fields: [marketId], references: [id], onDelete: Cascade)
  price  Price?

  @@unique([marketId, symbol])
  @@index([marketId, isActive])
  @@index([sector])
  @@index([industry])
  @@index([securityType])
  @@index([country])
}

// Latest price for an asset.
// source: 'scraper' (live scrape) or 'csv' (imported historical/API data).
model Price {
  assetId    String   @id
  price      Float
  changePct  Float
  marketCap  Float?
  volume     Float?
  peRatio    Float?
  // Richer fundamentals from yfinance (stocks).
  forwardPE          Float?
  dividendYield      Float? // percent, e.g. 2.5
  dividendRate       Float?
  eps                Float?
  beta               Float?
  dayHigh            Float?
  dayLow             Float?
  open               Float?
  previousClose      Float?
  fiftyTwoWeekHigh   Float?
  fiftyTwoWeekLow    Float?
  // Crypto-specific fields (crypto market only).
  rank               Float?
  fdv                Float?
  circulatingSupply  Float?
  totalSupply        Float?
  maxSupply          Float?
  ath                Float?
  atl                Float?
  athChangePct       Float?
  atlChangePct       Float?
  source     String   @default("scraper")
  updatedAt  DateTime @updatedAt

  asset Asset @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@index([marketCap])
  @@index([price])
  @@index([changePct])
  @@index([volume])
  @@index([peRatio])
}

// Cached index quotes per market, stored in JDDS so page loads never hit the
// network. Refreshed in the background by the scheduler.
model IndexQuote {
  id          String   @id @default(cuid())
  marketId    String
  symbol      String
  name        String
  price       Float
  change      Float
  changePct   Float
  updatedAt   DateTime @updatedAt

  @@unique([marketId, symbol])
}

// Cached news items ingested from RSS feeds in the background, so /api/news
// reads from JDDS instead of hitting every feed live on each request.
model NewsItem {
  id        String   @id @default(cuid())
  source    String
  ticker    String?
  headline  String
  summary   String?
  sentiment String   @default("neutral")
  timestamp DateTime
  url       String?
  // Feed metadata so filters (category/region/tier) work without refetching.
  category  String?
  region    String?
  tier      Int?
  // Dedup key: hash of url (or headline) — upserts are idempotent across runs.
  dedupKey  String   @unique

  @@index([timestamp])
  @@index([category])
  @@index([region])
  @@index([sentiment])
  @@index([ticker])
}

// Learned source reliability — powers self-healing source rotation.
model SourceHealth {
  id          String  @id @default(cuid())
  source      String  // strategy id, e.g. 'http', 'browser', 'search', 'crypto'
  market      String
  symbol      String  // '*' for whole-market default
  successCount Int    @default(0)
  failCount    Int    @default(0)
  lastStatus   String
  lastError    String?
  updatedAt    DateTime @updatedAt

  @@unique([source, market, symbol])
}

// User-configured cron jobs.
model CronJob {
  id              String   @id @default(cuid())
  type            String   @unique // 'price_refresh', 'universe_sync'
  intervalMinutes Int      @default(15)
  lastRunAt       DateTime?
  nextRunAt       DateTime?
  enabled         Boolean  @default(true)
}

// Slow-moving macro-economic series cached from external providers so the
// Economics page loads instantly from JDDS and refreshes in the background.
model MacroSeries {
  id        String   @id @default(cuid())
  cacheKey  String   @unique // source + params hash
  source    String
  seriesKey String // indicator / series id / label
  payload   String // JSON: normalized { date, value, ...rest } rows
  fetchedAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([source])
}

// Key-value system/user config.
model SystemConfig {
  key   String @id
  value String
}

// ─── Agentic Research Memory ─────────────────────────────────────────
// Persists what the research agents did so they can cite past findings,
// avoid redoing work, and "self-heal" (retry failed tool calls).

// A single research run triggered by a user query (e.g. "research PSX").
model ResearchReport {
  id          String   @id @default(cuid())
  query       String // the user's original request
  ticker      String? // primary symbol researched, if any
  market      String? // 'US', 'PK', 'IN', 'CRYPTO', ...
  status      String   @default("running") // running | done | failed
  summary     String? // final synthesized answer
  verdict     String? // e.g. 'bullish' | 'bearish' | 'neutral' | 'hold'
  confidence  Float? // 0..1
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  runs        AgentRun[]
  findings    ResearchFinding[]
}

// A log of one agent's work within a report (tool calls + outcomes).
model AgentRun {
  id          String   @id @default(cuid())
  reportId    String
  agent       String // 'orchestrator' | 'news' | 'fundamentals' | 'technical' | 'risk'
  status      String   @default("running") // running | done | failed
  toolCalls   Int      @default(0)
  toolErrors  Int      @default(0)
  output      String? // agent's raw output / notes
  startedAt   DateTime @default(now())
  finishedAt  DateTime?

  report ResearchReport @relation(fields: [reportId], references: [id], onDelete: Cascade)
}

// ─── Price & Condition Alerts ────────────────────────────────────────────
// A "watch" = a boolean condition tree over market data, evaluated on a
// server-side poll loop. When it fires, we dispatch via configured channels
// and log a PriceAlertEvent. Deleting a watch must NOT delete its events
// (no cascade on purpose — history survives).

// One alert rule (the watch).
model PriceAlert {
  id          String   @id @default(cuid())
  name        String
  symbols     String // JSON string[]
  market      String   @default("US")
  universe    String   @default("CUSTOM") // CUSTOM | MARKET
  conditions  String // JSON condition tree (leaf | group)
  logic       String   @default("AND") // AND | OR (top-level group)
  timeframe   String   @default("1d") // 1m 5m 15m 1h 1d
  dataSource  String   @default("Auto") // TradingView | yfinance | Auto
  mode        String   @default("poll") // poll (websocket = FUTURE)
  intervalSec Int      @default(60) // poll floor 30s
  cooldownMin Int      @default(15)
  actions     String   @default("{}") // JSON { toast?, channels?: string[] }
  active      Boolean  @default(true)
  status      String   @default("idle") // idle|warming|watching|triggered|error
  statusMsg   String?
  lastEvalAt  DateTime?
  lastFiredAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// History — one row per fired alert. NOT cascade-deleted with the watch.
model PriceAlertEvent {
  id      String   @id @default(cuid())
  alertId String
  symbol  String
  detail  String
  firedAt DateTime @default(now())

  @@index([alertId])
  @@index([firedAt])
}

// Candle cache for indicator conditions (SMA/EMA/RSI crossovers).
// Only cached per-watch for the symbols/timeframes that need it.
model Candles {
  symbol    String
  timeframe String
  ts        DateTime
  o         Float
  h         Float
  l         Float
  c         Float
  v         Float?

  @@id([symbol, timeframe, ts])
}

// A discrete fact / data point an agent gathered (for citation + memory).
model ResearchFinding {
  id        String   @id @default(cuid())
  reportId  String
  agent     String
  kind      String // 'price' | 'news' | 'fundamental' | 'technical' | 'risk' | 'search'
  ticker    String?
  title     String
  detail    String
  source    String?
  url       String?
  createdAt DateTime @default(now())

  report ResearchReport @relation(fields: [reportId], references: [id], onDelete: Cascade)
}

// ─── Trading Journal ─────────────────────────────────────────────────────
// SQLite-backed trading journal + performance intelligence. Every trade
// becomes structured data the analytics engine (and later the Agentic
// Harness) can reason over.
//
// The app is currently a guest/localStorage app with no auth model. These
// models are designed so a `userId` can be added later without a breaking
// rewrite: each top-level journal model carries an optional `owner` string
// (defaults to the single guest). When auth lands, add a User relation and
// scope queries by owner.

// The journal owner (guest profile). One row per user; the guest uses the
// default. Kept separate from auth so the journal works today and can be
// linked to a real User later.
model JournalProfile {
  id        String   @id @default(cuid())
  name      String   @default("Trader")
  currency  String   @default("USD")
  // Default risk per trade (fraction of account, e.g. 0.01 = 1%).
  riskPerTrade Float  @default(0.01)
  accountSize  Float  @default(10000)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  accounts  TradingAccount[]
  strategies Strategy[]
  setups    Setup[]
  tags      Tag[]
  days      JournalDay[]
  trades    Trade[]
  entries   JournalEntry[]
  reviews   Review[]
}

// A trading account the journal tracks P&L against.
model TradingAccount {
  id        String   @id @default(cuid())
  profileId String
  name      String
  currency  String   @default("USD")
  initialBalance Float @default(0)
  createdAt DateTime @default(now())

  profile JournalProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  trades  Trade[]

  @@index([profileId])
}

// A trading strategy / playbook. Rules are stored as structured rows so the
// analytics engine can score strategy compliance deterministically.
model Strategy {
  id        String   @id @default(cuid())
  profileId String
  name      String
  description String?
  markets   String // JSON string[] — markets this strategy trades
  confirmation String? // e.g. '15m'
  entry     String? // e.g. '1m'
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  profile JournalProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  rules    StrategyRule[]
  trades   Trade[]

  @@index([profileId])
}

// A single rule within a strategy (e.g. "Risk <= 1%", "Minimum 2R").
model StrategyRule {
  id         String   @id @default(cuid())
  strategyId String
  text       String
  category   String? // 'entry' | 'risk' | 'exit' | 'management'
  createdAt  DateTime @default(now())

  strategy Strategy @relation(fields: [strategyId], references: [id], onDelete: Cascade)

  @@index([strategyId])
}

// A named setup (e.g. "BOS + FVG", "Order Block", "Breakout").
model Setup {
  id        String   @id @default(cuid())
  profileId String
  name      String
  createdAt DateTime @default(now())

  profile JournalProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  trades   Trade[]

  @@unique([profileId, name])
  @@index([profileId])
}

// A free-form tag applied to trades (e.g. "overtrade", "revenge", "news").
model Tag {
  id        String   @id @default(cuid())
  profileId String
  name      String
  createdAt DateTime @default(now())

  profile JournalProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  trades   TradeTag[]

  @@unique([profileId, name])
  @@index([profileId])
}

// One trading day. Exists so a day can have a journal even with no trades.
model JournalDay {
  id        String   @id @default(cuid())
  profileId String
  date      DateTime // date-only (UTC midnight)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  profile JournalProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  review   DailyReview?
  emotion  DailyEmotion?
  trades   Trade[]

  @@unique([profileId, date])
  @@index([profileId, date])
}

// Pre-market / post-market written review for a day.
model DailyReview {
  id        String   @id @default(cuid())
  dayId     String
  marketBias String? // 'Bullish' | 'Bearish' | 'Neutral' | ...
  tradingPlan String? // rich text / markdown
  marketsWatching String? // JSON string[]
  keyLevels String? // rich text / structured
  wentWell  String?
  wentWrong String?
  followedStrategy String?
  biggestMistake String?
  lesson    String?
  tomorrow  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  day JournalDay @relation(fields: [dayId], references: [id], onDelete: Cascade)

  @@unique([dayId])
}

// Emotional state recorded for a day.
model DailyEmotion {
  id        String   @id @default(cuid())
  dayId     String
  state     String? // 'Calm' | 'Focused' | 'Nervous' | ...
  confidence Int?    // 1-5
  discipline Int?    // 1-5
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  day JournalDay @relation(fields: [dayId], references: [id], onDelete: Cascade)

  @@unique([dayId])
}

// A single trade. Core fields are denormalized for fast analytics; the
// execution log (TradeExecution) preserves the full history of changes.
model Trade {
  id        String   @id @default(cuid())
  profileId String
  accountId String?
  dayId     String?
  strategyId String?
  setupId   String?

  symbol    String
  direction String // 'LONG' | 'SHORT'
  entry     Float
  exit      Float
  stopLoss  Float?
  takeProfit Float?
  quantity  Float
  entryTime DateTime
  exitTime  DateTime

  // Optional structured context.
  timeframe String? // '1m' | '5m' | '15m' | '1h' | '1d' | ...
  session   String? // 'Asia' | 'London' | 'New York' | ...
  marketRegime String? // 'Trending' | 'Ranging' | ...
  trend     String? // 'Bullish' | 'Bearish' | 'Neutral'
  confluences Int?   // number of confluences
  emotion   String? // 'Calm' | 'FOMO' | 'Revenge' | ...
  confidence Int?    // 1-5
  mistakes  String? // JSON string[]
  notes     String?
  status    String   @default("closed") // 'open' | 'closed'

  // ── Auto-computed metrics (never user-entered) ────────────────────────
  pnl       Float
  pnlPct    Float
  rMultiple Float
  riskAmount Float?
  rewardAmount Float?
  actualRR  Float?
  durationSec Int?
  mfe       Float? // max favorable excursion (R)
  mae       Float? // max adverse excursion (R)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  profile  JournalProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  account  TradingAccount? @relation(fields: [accountId], references: [id], onDelete: SetNull)
  day      JournalDay? @relation(fields: [dayId], references: [id], onDelete: SetNull)
  strategy Strategy? @relation(fields: [strategyId], references: [id], onDelete: SetNull)
  setup    Setup? @relation(fields: [setupId], references: [id], onDelete: SetNull)
  executions TradeExecution[]
  screenshots TradeScreenshot[]
  annotations TradeAnnotation[]
  tags      TradeTag[]
  marketContext MarketContext?

  @@index([profileId, entryTime])
  @@index([profileId, symbol])
  @@index([profileId, strategyId])
  @@index([profileId, setupId])
  @@index([profileId, session])
  @@index([profileId, dayId])
}

// Event-sourcing-ready execution log. Each change to a trade (entry modified,
// stop moved, partial exit, final exit, closed) appends a row. This powers
// future behavioral analytics (did they move their stop? take profit early?).
model TradeExecution {
  id        String   @id @default(cuid())
  tradeId   String
  kind      String // 'created' | 'entry_modified' | 'stop_modified' | 'target_modified' | 'partial_exit' | 'final_exit' | 'closed'
  detail    String? // JSON snapshot of the change
  createdAt DateTime @default(now())

  trade Trade @relation(fields: [tradeId], references: [id], onDelete: Cascade)

  @@index([tradeId])
}

// A screenshot attached to a trade (before/during/after).
model TradeScreenshot {
  id        String   @id @default(cuid())
  tradeId   String
  url       String
  phase     String? // 'before' | 'during' | 'after'
  caption   String?
  createdAt DateTime @default(now())

  trade Trade @relation(fields: [tradeId], references: [id], onDelete: Cascade)

  @@index([tradeId])
}

// A chart annotation on a trade (entry, stop, target, FVG, BOS, ...).
model TradeAnnotation {
  id        String   @id @default(cuid())
  tradeId   String
  kind      String // 'entry' | 'stop' | 'target' | 'fvg' | 'bos' | 'order_block' | 'vwap' | 'support' | 'resistance'
  label     String?
  x         Float?
  y         Float?
  createdAt DateTime @default(now())

  trade Trade @relation(fields: [tradeId], references: [id], onDelete: Cascade)

  @@index([tradeId])
}

// Join table: trade ↔ tag.
model TradeTag {
  tradeId String
  tagId   String

  trade Trade @relation(fields: [tradeId], references: [id], onDelete: Cascade)
  tag   Tag   @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([tradeId, tagId])
  @@index([tagId])
}

// Market context auto-associated with a trade (decoupled from any provider).
model MarketContext {
  id        String   @id @default(cuid())
  tradeId   String
  trend     String?
  vwap      String? // 'above' | 'below'
  ema50AboveEma200 Boolean?
  adx       Float?
  atr       Float?
  regime    String?
  volatility String? // 'low' | 'medium' | 'high'
  session   String?
  raw       String? // JSON provider payload
  createdAt DateTime @default(now())

  trade Trade @relation(fields: [tradeId], references: [id], onDelete: Cascade)

  @@unique([tradeId])
}

// A free-form journal entry (not tied to a specific day/trade).
model JournalEntry {
  id        String   @id @default(cuid())
  profileId String
  title     String
  body      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  profile JournalProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId, createdAt])
}

// A review (weekly, monthly, or AI-generated trade review).
model Review {
  id        String   @id @default(cuid())
  profileId String
  kind      String // 'weekly' | 'monthly' | 'trade' | 'ai'
  periodStart DateTime?
  periodEnd   DateTime?
  tradeId   String?
  title     String
  body      String // markdown / rich text
  verdict   String?
  source    String   @default("manual") // 'manual' | 'ai'
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  profile JournalProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId, kind])
  @@index([profileId, createdAt])
}
