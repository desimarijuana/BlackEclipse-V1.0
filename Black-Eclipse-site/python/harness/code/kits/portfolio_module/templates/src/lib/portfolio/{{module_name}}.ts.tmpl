// {{class_name}} — generated by the `portfolio_module` kit.
//
// WHY this shape: portfolio analytics are PURE functions over explicit inputs (the
// repo's src/lib/portfolio convention), so they are testable and reusable. Series
// are date-aligned before combining. When inputs are absent the result is empty —
// never a fabricated figure.

export interface Position {
  name: string;
  weight: number;
}

export interface WeightedResult {
  total: number;
  contributions: Array<{ name: string; contribution: number }>;
}

export function {{class_name}}(positions: Position[] = []): WeightedResult {
  if (!Array.isArray(positions) || positions.length === 0) {
    return { total: 0, contributions: [] };
  }
  const total = positions.reduce((sum, p) => sum + p.weight, 0);
  if (total === 0) return { total: 0, contributions: [] };
  return {
    total,
    contributions: positions.map((p) => ({
      name: p.name,
      contribution: (p.weight / total) * 100,
    })),
  };
}
