"""The {{source_name}} importer — generated by the `data_ingestion_pipeline` kit.

WHY this shape: an importer must be IDEMPOTENT — running it twice must not
duplicate state — and must SKIP an absent row rather than fabricate one. That is
the scripts/import-*.js convention, in Python so it is testable without a database.

Fill `fetch_rows()` with the provider call; `ingest()` owns the idempotency.
"""

from __future__ import annotations

from dataclasses import dataclass, field
from typing import Any, Callable, Optional

SOURCE_NAME = "{{source_name}}"


@dataclass
class IngestResult:
    source: str = SOURCE_NAME
    inserted: int = 0
    skipped: int = 0
    seen: set = field(default_factory=set)


def ingest(
    existing: dict[str, Any],
    rows: Optional[list[dict[str, Any]]] = None,
    *,
    key: str = "id",
) -> tuple[dict[str, Any], IngestResult]:
    """Merge `rows` into `existing`, keyed by `key`, idempotently.

    A row missing its key is SKIPPED (never fabricated). A row whose key is already
    present is skipped, so running twice yields the identical mapping.
    """
    state = dict(existing)
    result = IngestResult(seen=set(state.keys()))
    for row in rows or []:
        if not isinstance(row, dict) or key not in row or row[key] in (None, ""):
            result.skipped += 1
            continue
        row_key = str(row[key])
        if row_key in state:
            result.skipped += 1
            continue
        state[row_key] = row
        result.inserted += 1
    return state, result


__all__ = ["SOURCE_NAME", "IngestResult", "ingest"]
