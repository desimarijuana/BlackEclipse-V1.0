"""Generated acceptance test for the {{source_name}} importer (kit: data_ingestion_pipeline).

WHY it ships WITH the artefact: the kit's acceptance rule is IDEMPOTENCY (running
twice yields the same state) and no fabricated rows.
"""

from __future__ import annotations

import importlib.util
import os

# This test lives at <root>/python/tests/; the importer is at <root>/scripts/.
_ROOT = os.path.dirname(os.path.dirname(os.path.dirname(os.path.abspath(__file__))))
_SPEC = importlib.util.spec_from_file_location(
    "import_{{module_name}}", os.path.join(_ROOT, "scripts", "import_{{module_name}}.py")
)
_module = importlib.util.module_from_spec(_SPEC)
_SPEC.loader.exec_module(_module)
ingest = _module.ingest


def test_ingest_is_idempotent():
    rows = [{"id": "a", "v": 1}, {"id": "b", "v": 2}]
    state1, r1 = ingest({}, rows)
    assert r1.inserted == 2
    state2, r2 = ingest(state1, rows)
    assert state2 == state1  # same state
    assert r2.inserted == 0 and r2.skipped == 2


def test_missing_key_row_is_skipped_never_fabricated():
    state, result = ingest({}, [{"v": 1}, {"id": "", "v": 2}, {"id": "c", "v": 3}])
    assert set(state) == {"c"}
    assert result.skipped == 2
