"""The {{class_name}} tool server — generated by the `mcp_server` kit.

WHY this shape: an MCP server is described by `mcp/config.py`'s contract — a
stdio command AS AN ARGUMENT ARRAY (never a shell string), a per-server env
allowlist, and per-tool effect classes. The server is INERT until an operator
enables it and selects a tool (discovery is not activation, ADR-H39). This module
exposes the DECLARATION the config layer validates; it holds no credential.

{{description}}
"""

from __future__ import annotations

from typing import Any

# The declared server, in the exact shape `mcp/config.py` accepts.
SERVER_CONFIG: dict[str, Any] = {
    "id": "{{module_name}}",
    "transport": "stdio",
    "command": "python",
    "args": ["-m", "harness.mcp_servers.{{module_name}}"],
    # No secrets here: use `secret_refs` (a NAME resolved from the vault at spawn).
    "env": {},
    "env_allowlist": [],
    "secret_refs": {},
    # Default OFF; the operator selects tools explicitly.
    "enabled": False,
    "selected_tools": [],
    "tool_effects": {
        "{{module_name}}_echo": "read",
    },
}

TOOLS: tuple[dict[str, Any], ...] = (
    {
        "name": "{{module_name}}_echo",
        "effect": "read",
        "description": "Return the input unchanged — the smallest proof the server is alive.",
    },
)


def list_tools() -> list[dict[str, Any]]:
    return [dict(tool) for tool in TOOLS]


def config() -> dict[str, Any]:
    return dict(SERVER_CONFIG)


__all__ = ["SERVER_CONFIG", "TOOLS", "config", "list_tools"]
