"""The {{class_name}} market-data source — generated by the `market_data_adapter` kit.

WHY this shape: every provider implements the SAME `RetrievalSource` contract
(`retrieval/sources.py`) so the planner can pick among sources without knowing a
provider's name. `retrieve()` NEVER raises and NEVER fabricates: when it has no
data it returns a `SourceOutcome` with status UNAVAILABLE, which is how the whole
runtime renders a gap (`AGENTS.md`: unavailable data renders UNAVAILABLE).
"""

from __future__ import annotations

from typing import Any

from .contract import (
    DataType,
    FinancialRetrievalRequest,
    NormalizedFinancialObject,
    SourceReference,
)
from .sources import SourceOutcome

{{class_name.upper()}}_DATA_TYPE: DataType = "{{data_type}}"


class {{class_name}}:
    """A {{data_type}} source. Fill in `_fetch` with the provider call."""

    name = "{{module_name}}"
    tier = "secondary"
    dataTypes: tuple[DataType, ...] = ({{class_name.upper()}}_DATA_TYPE,)

    def available(self, request: FinancialRetrievalRequest) -> bool:
        # Configured? A source with no credential simply reports unavailable.
        return True

    async def retrieve(self, request: FinancialRetrievalRequest) -> SourceOutcome:
        """Attempt the request. Never raises; UNAVAILABLE when there is no data."""
        try:
            rows = await self._fetch(request)
        except Exception as exc:  # noqa: BLE001 - a provider failure is data, not a crash
            return SourceOutcome(source=self.name, status="ERROR", error=str(exc))
        if not rows:
            return SourceOutcome(source=self.name, status="UNAVAILABLE")
        objects = [
            NormalizedFinancialObject(
                name=str(row.get("name") or "value"),
                value=row.get("value"),
                unit=row.get("unit"),
                currency=row.get("currency"),
                dataTimestamp=row.get("dataTimestamp"),
                period=row.get("period"),
            )
            for row in rows
        ]
        references = [SourceReference(source=self.name, sourceType="structured", query=request.objective)]
        return SourceOutcome(source=self.name, status="OK", objects=objects, references=references)

    async def _fetch(self, request: FinancialRetrievalRequest) -> list[dict[str, Any]]:
        """Return the provider's rows, or [] when there is nothing.

        Deliberately returns [] (UNAVAILABLE) rather than a default or a synthetic
        series — a generated source must never invent a figure.
        """
        return []


__all__ = ["{{class_name}}", "{{class_name.upper()}}_DATA_TYPE"]
