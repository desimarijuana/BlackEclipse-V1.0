"""The {{strategy_name}} backtest — generated by the `backtest_strategy` kit.

WHY this shape: a backtest must (a) run over EXPLICIT inputs, (b) state its period
and inputs on its result, (c) label an in-sample metric as in-sample and never
present it as predictive, and (d) return UNAVAILABLE — never a synthetic series or
an extrapolation — when its prices are absent.
"""

from __future__ import annotations

from dataclasses import dataclass, field
from typing import Any, Optional

STRATEGY_NAME = "{{strategy_name}}"
DEFAULT_PERIOD = "{{period}}"
UNAVAILABLE = "UNAVAILABLE"


@dataclass
class BacktestResult:
    strategy: str = STRATEGY_NAME
    period: str = DEFAULT_PERIOD
    status: str = UNAVAILABLE
    # An in-sample result is labelled as such and is NEVER presented as predictive.
    inSample: bool = True  # noqa: N815
    metrics: dict[str, float] = field(default_factory=dict)
    inputs: dict[str, Any] = field(default_factory=dict)
    reason: str = ""
    limitations: list[str] = field(default_factory=lambda: [
        "metrics are in-sample and are not a forecast of future performance",
        "results depend on the supplied price series and period",
    ])

    def to_dict(self) -> dict[str, Any]:
        return {
            "strategy": self.strategy, "period": self.period, "status": self.status,
            "inSample": self.inSample, "metrics": self.metrics, "inputs": self.inputs,
            "reason": self.reason, "limitations": self.limitations,
        }


def run_backtest(prices: Optional[list[float]] = None, *, period: Optional[str] = None) -> BacktestResult:
    """Run the {{strategy_name}} strategy over the supplied prices.

    A missing or empty price series is UNAVAILABLE — never a synthetic series.
    """
    result = BacktestResult(period=period or DEFAULT_PERIOD, inputs={"prices": prices})
    if not prices:
        result.reason = "no price series was supplied"
        return result  # status stays UNAVAILABLE
    returns = [prices[i] / prices[i - 1] - 1.0 for i in range(1, len(prices)) if prices[i - 1]]
    if not returns:
        result.reason = "not enough prices to form a return"
        return result
    result.status = "OK"
    result.metrics = {
        "totalReturnPct": round((prices[-1] / prices[0] - 1.0) * 100, 4) if prices[0] else 0.0,
        "observations": float(len(prices)),
        "meanReturnPct": round(sum(returns) / len(returns) * 100, 6),
    }
    return result


__all__ = ["STRATEGY_NAME", "DEFAULT_PERIOD", "UNAVAILABLE", "BacktestResult", "run_backtest"]
