// {{indicator_name}} — generated by the `chart_indicator` kit.
//
// WHY this shape: a chart indicator is a PURE function over explicit numbers — no
// I/O, no globals — so it is trivially testable (the repo's own gate is vitest).
// When the input is too short it returns an EMPTY series, never a fabricated
// point: a chart must not draw a value that was not computed.

export function {{class_name}}(values: number[], window = 3): number[] {
  if (!Array.isArray(values) || values.length < window || window < 1) return [];
  const out: number[] = [];
  for (let i = window - 1; i < values.length; i += 1) {
    let sum = 0;
    for (let j = i - window + 1; j <= i; j += 1) sum += values[j];
    out.push(sum / window);
  }
  return out;
}
