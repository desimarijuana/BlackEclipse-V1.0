"""The {{ratio_name}} ratio — generated by Eclipse from the `ratio_calculator` kit.

WHY this shape: a ratio must follow the same discipline as everything in
`research/calculations.py` — it computes from EXPLICIT inputs, carries its formula
and inputs so the number can be explained, and returns UNAVAILABLE (never a
default or an estimate) when a required input is absent. A generated ratio can
therefore never fabricate a financial figure.
"""

from __future__ import annotations

from dataclasses import dataclass, field
from typing import Any, Optional

RATIO_NAME = "{{ratio_name}}"
RATIO_VERSION = "1.0.0"
RATIO_FORMULA = "{{description}}"

# The existing convention: no evidence renders UNAVAILABLE, never a guess.
UNAVAILABLE = "UNAVAILABLE"


@dataclass
class RatioResult:
    """The auditable outcome of one ratio computation."""

    name: str = RATIO_NAME
    version: str = RATIO_VERSION
    formula: str = RATIO_FORMULA
    status: str = UNAVAILABLE
    value: Optional[float] = None
    inputs: dict[str, Any] = field(default_factory=dict)
    missing: list[str] = field(default_factory=list)
    reason: str = ""

    def to_dict(self) -> dict[str, Any]:
        return {
            "name": self.name,
            "version": self.version,
            "formula": self.formula,
            "status": self.status,
            "value": self.value,
            "inputs": self.inputs,
            "missing": self.missing,
            "reason": self.reason,
        }


def compute_ratio(*, numerator: Any = None, denominator: Any = None) -> RatioResult:
    """Compute the {{ratio_name}} ratio.

    Missing inputs are UNAVAILABLE, never a default. A zero denominator is
    undefined and is refused honestly rather than forced to 0.
    """
    result = RatioResult(inputs={"numerator": numerator, "denominator": denominator})
    missing: list[str] = []
    if numerator is None:
        missing.append("numerator")
    if denominator is None:
        missing.append("denominator")
    if missing:
        result.missing = missing
        result.reason = "required input(s) missing: " + ", ".join(missing)
        return result  # status stays UNAVAILABLE
    try:
        num = float(numerator)
        den = float(denominator)
    except (TypeError, ValueError):
        result.missing = ["numerator", "denominator"]
        result.reason = "inputs must be numbers"
        return result
    if den == 0:
        result.reason = "the denominator is zero, so the ratio is undefined"
        return result
    result.status = "OK"
    result.value = num / den
    return result


__all__ = ["RATIO_NAME", "RATIO_VERSION", "RATIO_FORMULA", "UNAVAILABLE", "RatioResult", "compute_ratio"]
