    "maxSteps": 8,
    "timeoutMs": 120000,
    "maxToolCalls": 24
  },
  "author": "eclipse",
  "origin": "builtin",
  "compatibleRuntime": ">=0.1.0",
  "outputSchema": {
    "type": "object",
    "properties": {
      "data": {
        "type": "object"
      },
      "endpoint": {
        "type": "string"
      },
      "rate_limit": {
        "type": "string"
      },
      "notes": {
        "type": "array"
      }
    },
    "required": [
      "data",
      "endpoint",
      "rate_limit",
      "notes"
    ]
  }
}
