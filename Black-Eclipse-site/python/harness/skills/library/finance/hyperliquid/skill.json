{
  "id": "finance.hyperliquid",
  "name": "Hyperliquid Reference",
  "version": "1.0.0",
  "description": "Hyperliquid read-only reference: Info endpoint, WebSocket subscriptions, HyperEVM RPC and rate limits for prices, books, funding and positions.",
  "category": "finance",
  "tags": [
    "hyperliquid",
    "perps",
    "onchain",
    "api",
    "reference"
  ],
  "status": "draft",
  "instructions": "SKILL.md",
  "inputSchema": {
    "type": "object",
    "properties": {
      "dataset": {
        "type": "string",
        "enum": [
          "prices",
          "candles",
          "book",
          "funding",
          "positions",
          "hyperevm"
        ]
      },
      "coin": {
        "type": "string"
      }
    },
    "required": [
      "dataset"
    ]
  },
  "requiredTools": [
    "get_market_snapshot",
    "get_orderbook",
    "get_funding_rate",
    "get_open_interest",
    "get_trades",
    "get_quote"
  ],
