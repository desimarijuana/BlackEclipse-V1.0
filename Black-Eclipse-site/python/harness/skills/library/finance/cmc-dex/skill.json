{
  "id": "finance.cmc-dex",
  "name": "CoinMarketCap DEX API",
  "version": "1.0.0",
  "description": "Reference for CoinMarketCap DEX endpoints: token lookup, pools, transactions, trending and security analysis.",
  "category": "finance",
  "tags": [
    "coinmarketcap",
    "dex",
    "onchain",
    "api",
    "reference"
  ],
  "status": "draft",
  "instructions": "SKILL.md",
  "inputSchema": {
    "type": "object",
    "properties": {
      "chain": {
        "type": "string"
      },
      "contract": {
        "type": "string"
      },
      "dataset": {
        "type": "string",
        "enum": [
          "token",
          "pools",
          "transactions",
          "trending",
          "security"
        ]
      }
    }
  },
  "requiredTools": [
    "get_market_snapshot",
    "get_ohlcv",
    "get_trades",
    "web_search",
    "web_extract"
  ],
  "requiredSkills": [
    "finance.market-data"
  ],
  "permissions": [
    "data.read",
    "research.read"
  ],
  "riskLevel": "medium",
  "limits": {
    "maxSteps": 8,
    "timeoutMs": 120000,
    "maxToolCalls": 20
  },
  "author": "eclipse",
  "origin": "builtin",
  "compatibleRuntime": ">=0.1.0",
  "outputSchema": {
    "type": "object",
    "properties": {
      "endpoint": {
        "type": "string"
      },
      "data": {
        "type": "object"
      },
      "security": {
        "type": "object"
      },
      "notes": {
        "type": "array"
      }
    },
    "required": [
      "endpoint",
      "data",
      "security",
      "notes"
    ]
  }
}
