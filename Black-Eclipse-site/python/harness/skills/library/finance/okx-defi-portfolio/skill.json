{
  "id": "finance.okx-defi-portfolio",
  "name": "OKX DeFi Portfolio",
  "version": "1.0.0",
  "description": "Read OKX DeFi positions across staking and lending protocols, including per-protocol detail and position overview.",
  "category": "finance",
  "tags": [
    "okx",
    "defi",
    "portfolio",
    "staking",
    "lending"
  ],
  "status": "draft",
  "instructions": "SKILL.md",
  "inputSchema": {
    "type": "object",
    "properties": {
      "view": {
        "type": "string",
