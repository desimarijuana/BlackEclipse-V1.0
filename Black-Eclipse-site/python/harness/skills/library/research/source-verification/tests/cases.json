{
  "cases": [
    {
      "caseId": "accepts-claims",
      "name": "Accepts a claim list",
      "kind": "input_validation",
      "input": { "claims": [{ "claim": "Revenue grew 12%" }] },
      "expected": { "valid": true }
    },
    {
      "caseId": "rejects-missing-claims",
      "name": "Rejects input without claims",
      "kind": "input_validation",
      "input": {},
      "expected": { "valid": false }
    },
    {
      "caseId": "output-shape",
      "name": "Output separates verified from unverified",
      "kind": "output_shape",
      "expected": {
        "required": ["verified", "unverified", "conflicts", "missingEvidence", "confidenceLimitations"]
      }
    },
    {
      "caseId": "output-valid-full",
      "name": "A complete verification validates",
      "kind": "output_validation",
      "expected": {
        "valid": true,
        "output": {
          "verified": [{"claim": "Revenue grew", "source": "SEC"}],
          "unverified": [],
          "conflicts": [],
          "missingEvidence": [],
          "confidenceLimitations": ["single source"],
          "overallConfidence": "medium"
        }
      }
    },
    {
      "caseId": "output-missing-required",
      "name": "A verification missing required arrays fails",
      "kind": "output_validation",
      "expected": {
        "valid": false,
        "output": { "verified": [], "unverified": [] }
      }
    }
  ]
}
