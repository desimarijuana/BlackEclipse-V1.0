{
  "id": "system.canva",
  "name": "Canva",
  "version": "1.0.0",
  "description": "Create, update, import, export and open Canva designs through a connected Canva account.",
  "category": "system",
  "tags": [
    "canva",
    "design",
    "media",
    "export",
    "templates"
  ],
  "status": "draft",
  "instructions": "SKILL.md",
  "inputSchema": {
    "type": "object",
    "properties": {
      "action": {
        "type": "string",
        "enum": [
          "create",
          "update",
          "import",
          "export",
          "open"
        ]
      },
      "brief": {
        "type": "string"
      },
      "design_id": {
        "type": "string"
      }
    },
    "required": [
      "action"
    ]
  },
  "requiredTools": [
    "image_generate",
    "document_create",
    "web_search"
  ],
  "requiredSkills": [],
  "permissions": [
    "external.network"
  ],
  "riskLevel": "low",
  "limits": {
    "maxSteps": 7,
    "timeoutMs": 120000,
    "maxToolCalls": 12
  },
  "author": "eclipse",
  "origin": "builtin",
  "compatibleRuntime": ">=0.1.0",
  "outputSchema": {
    "type": "object",
    "properties": {
      "design": {
        "type": "object"
      },
      "export": {
        "type": "object"
      },
      "warnings": {
        "type": "array"
      }
    },
    "required": [
      "design",
      "export",
      "warnings"
    ]
  }
}
