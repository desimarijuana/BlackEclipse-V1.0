{
  "cases": [
    {
      "caseId": "accepts-title-and-sections",
      "name": "Accepts a title and sections",
      "kind": "input_validation",
      "input": { "title": "ACME FY24", "sections": [{ "body": "..." }] },
      "expected": { "valid": true }
    },
    {
      "caseId": "rejects-missing-sections",
      "name": "Rejects input without sections",
      "kind": "input_validation",
      "input": { "title": "ACME FY24" },
      "expected": { "valid": false }
    },
    {
      "caseId": "output-shape",
      "name": "Output preserves references and uncertainty",
      "kind": "output_shape",
      "expected": {
        "required": ["title", "body", "references", "assumptions", "missingData", "uncertainty"]
      }
    },
    {
      "caseId": "output-valid-full",
      "name": "A complete report validates",
      "kind": "output_validation",
      "expected": {
        "valid": true,
        "output": {
          "title": "ACME FY24",
          "format": "markdown",
          "body": "# ACME",
          "references": [{"source": "SEC"}],
          "assumptions": ["figures as reported"],
          "missingData": [],
          "uncertainty": [],
          "reportedVsDerived": {"reported": 2, "derived": 1}
        }
      }
    },
    {
      "caseId": "output-missing-required",
      "name": "A report missing references fails",
      "kind": "output_validation",
      "expected": {
        "valid": false,
        "output": { "title": "ACME", "body": "x", "assumptions": [], "missingData": [], "uncertainty": [] }
      }
    }
  ]
}
