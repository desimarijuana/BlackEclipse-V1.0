      "category": "finance",
      "difficulty": "easy",
      "input": {"prompt": "Revenue is 1000 and net income is 120. What is the net margin?"},
      "expected_output": {"numeric": {"value": 12.0, "tolerance": 0.01}},
      "graders": [
        {"name": "financial", "config": {"metric": "net_margin", "inputs": {"revenue": 1000, "net_income": 120}, "tolerance": 0.01}},
        {"name": "exact"}
      ],
      "metadata": {
        "tier": 0,
        "suites": ["finance"],
        "agent_script": [{"type": "final", "content": "The net margin is 12.0% (120 / 1000)."}]
      }
